FROM ghcr.io/astral-sh/uv:0.9.7@sha256:ba4857bf2a068e9bc0e64eed8563b065908a4cd6bfb66b531a9c424c8e25e142 AS uvbin

FROM docker.io/library/python:3.13-bookworm@sha256:645626b340bf70c06f185ea425c8bba35c0491ef79df42168cd4dfedc58a6365

COPY --from=uvbin /uv /uvx /usr/local/bin/

WORKDIR /opt/site-pipeline
COPY README.md pyproject.toml uv.lock main.py DISCLAIMER dist-release-legal/LICENSE dist-release-legal/NOTICE ./
COPY src ./src
COPY tools/helpers ./tools/helpers
RUN set -eux; \
    : "Install base OS runtime packages."; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates; \
    rm -rf /var/lib/apt/lists/*; \
    : "Prepare the build-time license layout expected by setuptools."; \
    mkdir -p dist-release-legal; \
    cp LICENSE NOTICE dist-release-legal/; \
    : "Install the packaged CLI into the runtime virtual environment."; \
    uv sync --frozen --no-dev --no-editable; \
    uv pip install --python /opt/site-pipeline/.venv/bin/python --no-deps .; \
    : "Drop build-only inputs from the final image."; \
    rm -rf tools dist-release-legal pyproject.toml uv.lock; \
    : "Create the non-root runtime user."; \
    groupadd --system --gid 10001 site-pipeline; \
    useradd --system --uid 10001 --gid site-pipeline --create-home --home-dir /home/site-pipeline site-pipeline; \
    mkdir -p /workspace; \
    chown -R site-pipeline:site-pipeline /home/site-pipeline /workspace

ENV PATH=/opt/site-pipeline/.venv/bin:$PATH \
    HOME=/home/site-pipeline \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
USER site-pipeline
ENTRYPOINT ["site-pipeline"]
CMD ["--help"]
