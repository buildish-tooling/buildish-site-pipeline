FROM ghcr.io/astral-sh/uv:0.9.7@sha256:ba4857bf2a068e9bc0e64eed8563b065908a4cd6bfb66b531a9c424c8e25e142 AS uvbin

FROM docker.io/library/python:3.13-bookworm@sha256:345d669f21b1ab934cb67f2015a713ec041bb2ebb8e3f069484839361f64cc53

RUN apt-get update     && apt-get install -y --no-install-recommends ca-certificates     && rm -rf /var/lib/apt/lists/*

COPY --from=uvbin /uv /uvx /usr/local/bin/

WORKDIR /opt/site-pipeline
COPY README.md pyproject.toml uv.lock main.py ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable \
    && uv pip install --python /opt/site-pipeline/.venv/bin/python --no-deps .
COPY DISCLAIMER ./DISCLAIMER
COPY dist-release-legal/LICENSE dist-release-legal/NOTICE ./

ENV PATH=/opt/site-pipeline/.venv/bin:$PATH
WORKDIR /workspace
ENTRYPOINT ["site-pipeline"]
CMD ["--help"]
